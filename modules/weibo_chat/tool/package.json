{
  "name": "weibo-chat-export",
  "version": "1.0.0",
  "description": "把微博网页版私信聊天记录导出成离线可读的本地 HTML，图片、语音、视频一并保存",
  "main": "工具/export.js",
  "scripts": {
    "start": "node 工具/export.js",
    "login": "node 工具/export.js --login",
    "status": "node 工具/export.js --status",
    "full": "node 工具/export.js --mode=full"
  },
  "keywords": [
    "weibo",
    "weibo-chat",
    "chat-export",
    "playwright",
    "备份"
  ],
  "dependencies": {
    "playwright-core": "^1.40.0"
  },
  "engines": {
    "node": ">=16"
  }
}
